# ===== MySQL =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_bedrok

# ===== Flask =====
FLASK_SECRET_KEY=genera-una-clave-larga-aleatoria

# ===== Factus API facturacion (sandbox del reto) =====
# Credenciales entregadas por Halltec/Factus al correo del equipo.
FACTUS_CLIENT_ID=CLIENT_ID_DEL_RETO
FACTUS_CLIENT_SECRET=CLIENT_SECRET_DEL_RETO
FACTUS_USERNAME=sandboxv2@factus.com.co
FACTUS_PASSWORD=SANDBOX_PASSWORD

# ===== Factus Pay (QR Bre-B, sandbox del reto) =====
# Panel: https://pay-api-sandbox.factus.com.co/
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=email-del-panel
FACTUS_PAY_PASSWORD=password-del-panel

# Llave del webhook: defínela tú y regístrala en el panel Factus Pay (seccion Webhook).
# Debe coincidir con ?key= de https://TU-DOMINIO/webhooks/factus-pay?key=ESTA_LLAVE
FACTUS_PAY_WEBHOOK_KEY=genera-una-llave-larga-aleatoria-32-caracteres
